# bog environment file
# Central place for credentials and per-service config used by bog's
# optional service stacks (bog-media-centre and future additions).
# This file is seeded once and then fully yours — edit freely.
#
# After changing values here, restart the relevant service, e.g.:
#	systemctl --user restart bog-media-centre.service

# Shared
TZ=Australia/Sydney
PUID=1000
PGID=1000

# Gluetun (VPN gateway)
# Uncomment ONE provider block, fill in your credentials, comment out the rest.
# Full reference: https://github.com/qdm12/gluetun-wiki/tree/main/setup

# Mullvad
#VPN_SERVICE_PROVIDER=mullvad
#VPN_TYPE=wireguard
#WIREGUARD_PRIVATE_KEY=
#WIREGUARD_ADDRESSES=
#SERVER_CITIES=

# Private Internet Access
#VPN_SERVICE_PROVIDER=private internet access
#VPN_TYPE=openvpn
#OPENVPN_USER=
#OPENVPN_PASSWORD=
#SERVER_REGIONS=

# Generic fallback (any other Gluetun-supported provider)
#VPN_SERVICE_PROVIDER=
#VPN_TYPE=
#OPENVPN_USER=
#OPENVPN_PASSWORD=

FIREWALL_OUTBOUND_SUBNETS=