[org.gnome.shell.extensions.appindicator]
compact-mode-enabled=true
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
icon-saturation=0.0
icon-size=0
legacy-tray-enabled=true

[org.gnome.shell.extensions.caffeine]
show-indicator='only-active'
enable-fullscreen=true
restore-state=true
cli-toggle=false
nightlight-control='never'
screen-blank='never'

[org.gnome.shell.extensions.gtk4-ding]
show-desktop-widgets=false

[org.gnome.shell.extensions.quick-sound-switcher]
show-profiles=false

[org.gnome.shell.extensions.dash-to-panel]
appicon-margin=2
appicon-padding=4
dot-position='BOTTOM'
dot-style-focused='DOTS'
dot-style-unfocused='DOTS'
extension-version=74
global-border-radius=1
hotkeys-overlay-combo='TEMPORARILY'
leftbox-padding=-1
leftbox-size=0
panel-anchors='{"CMN-0x00000000":"MIDDLE","unknown-unknown":"MIDDLE"}'
panel-element-positions='{"CMN-0x00000000":[{"element":"activitiesButton","visible":true,"position":"stackedTL"},{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":true,"position":"centered"},{"element":"dateMenu","visible":true,"position":"centerMonitor"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}],"unknown-unknown":[{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":true,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}]}'
panel-lengths='{"CMN-0x00000000":100,"unknown-unknown":100}'
panel-positions='{"CMN-0x00000000":"TOP","unknown-unknown":"BOTTOM"}'
panel-side-margins=0
panel-side-padding=4
panel-sizes='{"CMN-0x00000000":32}'
panel-top-bottom-margins=0
panel-top-bottom-padding=4
prefs-opened=false
show-apps-icon-file=''
status-icon-padding=-1
tray-padding=-1
window-preview-title-position='TOP'