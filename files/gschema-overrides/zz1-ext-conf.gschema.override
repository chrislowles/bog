[org.gnome.shell.extensions.appindicator]
compact-mode-enabled=true
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
icon-saturation=0.0
icon-size=0
legacy-tray-enabled=true

[org.gnome.shell.extensions.caffeine]
show-indicator='only-active'
enable-fullscreen=true
restore-state=true
cli-toggle=false
nightlight-control='never'
screen-blank='never'

[org.gnome.shell.extensions.gtk4-ding]
show-desktop-widgets=false

[org.gnome.shell.extensions.quick-sound-switcher]
show-profiles=false

[org.gnome.shell.extensions.dash-to-panel]
animate-appicon-hover-animation-extent={'RIPPLE': 4, 'PLANK': 4, 'SIMPLE': 1}
appicon-margin=0
appicon-padding=4
appicon-style='NORMAL'
context-menu-entries='[{"title":"Terminal","cmd":"TERMINALSETTINGS"},{"title":"Task Manager","cmd":"gnome-system-monitor"},{"title":"Files","cmd":"nautilus"},{"title":"Applications","cmd":"bazaar"}]'
dot-position='BOTTOM'
dot-style-focused='DOTS'
dot-style-unfocused='DOTS'
extension-version=73
global-border-radius=0
group-apps=true
group-apps-use-fixed-width=true
hide-overview-on-startup=true
hot-keys=true
hotkeys-overlay-combo='TEMPORARILY'
intellihide=false
middle-click-action='LAUNCH'
panel-anchors='{"CMN-0x00000000":"MIDDLE"}'
panel-element-positions='{"CMN-0x00000000":[{"element":"activitiesButton","visible":true,"position":"stackedTL"},{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":true,"position":"centered"},{"element":"dateMenu","visible":true,"position":"centerMonitor"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}]}'
panel-lengths='{"CMN-0x00000000":100}'
panel-positions='{"CMN-0x00000000":"TOP"}'
panel-side-margins=0
panel-side-padding=0
panel-sizes='{"CMN-0x00000000":32}'
panel-top-bottom-margins=0
panel-top-bottom-padding=0
prefs-opened=false
scroll-icon-action='PASS_THROUGH'
scroll-panel-action='NOTHING'
shift-click-action='MINIMIZE'
shift-middle-click-action='LAUNCH'
show-apps-icon-file=''
show-apps-icon-side-padding=2
show-favorites-all-monitors=true
showdesktop-button-width=6
stockgs-keep-dash=false
stockgs-keep-top-panel=false
stockgs-panelbtn-click-only=false
trans-dynamic-anim-target=1.0
trans-dynamic-anim-time=0
trans-panel-opacity=0.0
trans-use-border=false
trans-use-custom-bg=false
trans-use-custom-opacity=true
trans-use-dynamic-opacity=true
window-preview-title-position='TOP'