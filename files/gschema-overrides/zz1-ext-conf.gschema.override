[org.gnome.shell.extensions.appindicator]
compact-mode-enabled=true
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
icon-saturation=0.0
icon-size=0
legacy-tray-enabled=true

[org.gnome.shell.extensions.caffeine]
show-indicator='only-active'
enable-fullscreen=true
restore-state=true
cli-toggle=false
nightlight-control='never'
screen-blank='never'

[org.gnome.shell.extensions.gtk4-ding]
show-desktop-widgets=false

[org.gnome.shell.extensions.quick-sound-switcher]
show-profiles=false

[org.gnome.shell.extensions.rss-feed]
click-action-middle='none'
click-action-right='none'
display-mode='notifications-only'
enable-notifications-locked=true
group-notifications-by-source=true
hover-action-1='older'
hover-action-2='copy'
hover-action-3='open'
items-retained=50
mark-initial-as-new=true
notification-limit=4
rss-feeds-list=['https://www.abc.net.au/news/feed/51120/rss.xml', 'https://www.abc.net.au/news/feed/10719986/rss.xml', 'https://www.abc.net.au/news/feed/104217382/rss.xml']
rss-feeds-settings='{"https://www.abc.net.au/news/feed/51120/rss.xml":{"t":"Just In","n":false},"https://www.abc.net.au/news/feed/10719986/rss.xml":{"t":"Top Stories"},"https://www.abc.net.au/news/feed/104217382/rss.xml":{"t":"World"}}'
update-interval=5